# URL pública definitiva del sitio (sin barra final). Se usa en metadata, sitemap y datos estructurados.
NEXT_PUBLIC_SITE_URL=https://www.salhen.cl

# Contacto público. Si una variable queda vacía, el sitio no muestra ese dato.
# WhatsApp en formato internacional sin "+" ni espacios, por ejemplo 569XXXXXXXX.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Entrega de cotizaciones (servidor, no se expone al navegador).
# Endpoint que recibe la solicitud como multipart/form-data: un CRM, un webhook de
# automatización (Make, n8n, Zapier) o un servicio propio. Sin este valor el formulario
# responde "envío no habilitado" y no simula un envío exitoso.
QUOTE_WEBHOOK_URL=
# Token opcional que se envía en la cabecera Authorization: Bearer <token>.
QUOTE_WEBHOOK_TOKEN=
